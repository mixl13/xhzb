<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xhzb.nursing.mapper.AiChatConversationMapper">

    <resultMap type="AiChatConversation" id="AiChatConversationResult">
        <result property="id"             column="id"              />
        <result property="conversationId" column="conversation_id"  />
        <result property="userId"         column="user_id"          />
        <result property="title"          column="title"            />
        <result property="messageCount"   column="message_count"    />
        <result property="status"         column="status"           />
        <result property="createBy"       column="create_by"        />
        <result property="createTime"     column="create_time"      />
        <result property="updateBy"       column="update_by"        />
        <result property="updateTime"     column="update_time"      />
        <result property="remark"         column="remark"           />
    </resultMap>

    <resultMap type="AiChatConversationVo" id="AiChatConversationVoResult">
        <result property="conversationId" column="conversation_id"  />
        <result property="title"          column="title"            />
        <result property="messageCount"   column="message_count"    />
        <result property="createTime"     column="create_time"      />
        <result property="updateTime"     column="update_time"      />
    </resultMap>

    <sql id="selectAiChatConversationVo">
        select id, conversation_id, user_id, title, message_count, status,
               create_by, create_time, update_by, update_time, remark
        from ai_chat_conversation
    </sql>

    <select id="selectByConversationId" parameterType="String" resultMap="AiChatConversationResult">
        <include refid="selectAiChatConversationVo"/>
        where conversation_id = #{conversationId}
    </select>

    <!-- 会话隔离核心SQL：所有查询都带 user_id 条件，保证用户只能看到自己的会话 -->
    <select id="selectConversationVoByUserId" parameterType="Long" resultMap="AiChatConversationVoResult">
        <include refid="selectAiChatConversationVo"/>
        where user_id = #{userId} and status = '0'
        order by update_time desc, id desc
    </select>

    <!-- 会话隔离：仅返回当前用户名下、未删除的会话 -->
    <!-- 按最近活跃时间倒序：incrementMessageCount 每次对话都会刷新 update_time，
         保证刚聊过的会话排在列表最前，与前端默认加载第一条的行为一致 -->
    <select id="selectConversationIdByUserId" parameterType="Long" resultType="String">
        select conversation_id
        from ai_chat_conversation
        where user_id = #{userId} and status = '0'
        order by update_time desc, id desc
    </select>

    <update id="incrementMessageCount">
        update ai_chat_conversation
        set message_count = message_count + #{count}, update_time = sysdate()
        where conversation_id = #{conversationId}
    </update>

    <update id="updateTitleIfBlank">
        update ai_chat_conversation
        set title = #{title}, update_time = sysdate()
        where conversation_id = #{conversationId}
          and (title is null or title = '' or title = '新会话')
    </update>

    <update id="updateStatusByConversationId">
        update ai_chat_conversation
        set status = #{status}, update_time = sysdate()
        where conversation_id = #{conversationId}
          and user_id = #{userId}
    </update>

</mapper>
